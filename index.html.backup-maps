<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ZahraCell2 | Toko Digital, BRILink, ATK & Alat Listrik</title>
    <link rel="stylesheet" href="style.css">
    
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <header class="navbar">

        <div class="container nav-container">

            <a href="#home" class="logo">
                <span class="logo-icon">
                    <img src="image/logo.jpeg" alt="Zahracell2">
                </span>
                <span>
                <strong>Zahracell2</strong><br>
                
                </span>
            </a>

            <button class="menu-toggle" type="button" aria-label="Buka menu" aria-expanded="false">
                ☰
            </button>

            <nav class="nav-menu">

                <a href="#home">Home</a>
                <a href="#tentang">Tentang</a>
                <a href="#layanan">Layanan</a>
                <a href="#produk">Produk</a>
                <a href="#galeri">Galeri</a>
                <a href="#kontak">Kontak</a>

            </nav>

            <a href="#kontak" class="nav-button">
                Hubungi Kami
            </a>

        </div>

    </header>


    <main>

        <!-- ================= HERO ================= -->

        <section id="home" class="hero">

            <div class="container hero-container">

                <div class="hero-content">

                    <div class="hero-badge">
                        ⭐ Melayani dengan sepenuh hati
                    </div>

                    <h1>
                        Selamat Datang di
                        <span>ZahraCell2</span>
                    </h1>

                    <p class="hero-description">
                        Pusat layanan digital, BRILink, ATK dan
                        perlengkapan listrik untuk kebutuhan sehari-hari
                        Anda.
                    </p>

                    <div class="hero-buttons">

                        <a href="#layanan" class="btn btn-primary">
                            Lihat Layanan
                        </a>

                        <a href="#kontak" class="btn btn-outline">
                            Hubungi Kami
                        </a>

                    </div>

                    <div class="hero-info">

                        <div>
                            <strong>✓</strong>
                            <span>Pelayanan Ramah</span>
                        </div>

                        <div>
                            <strong>✓</strong>
                            <span>Harga Bersahabat</span>
                        </div>

                        <div>
                            <strong>✓</strong>
                            <span>Layanan Terpercaya</span>
                        </div>

                    </div>

                </div>


                <div class="hero-card">

                    <div class="hero-card-inner">

                         <img src="image/logo.jpeg" alt="ZahraCell2" class="hero-logo">

                        <h2>ZahraCell2</h2>

                        <p>
                            Toko & Layanan Digital
                        </p>

                        <div class="hero-card-line"></div>

                        <div class="hero-services">

                            <span>BRILink</span>
                            <span>Pulsa</span>
                            <span>ATK</span>
                            <span>Listrik</span>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- ================= TENTANG ================= -->

        <section id="tentang" class="section about">

            <div class="container">

                <div class="section-heading">

                    <span class="section-label">
                        TENTANG KAMI
                    </span>

                    <h2>
                        Mengenal ZahraCell2
                    </h2>

                    <p>
                        ZahraCell2 hadir untuk memberikan berbagai
                        kebutuhan digital dan kebutuhan sehari-hari
                        masyarakat dalam satu tempat.
                    </p>

                </div>


                <div class="about-photos">
                    <div class="about-photo-main">
                        <img src="image/about/toko2.jpg" alt="Toko ZahraCell2" loading="lazy">
                    </div>

                    <div class="about-photo-side">
                        <img src="image/about/spanduk.jpg" alt="Spanduk ZahraCell2" loading="lazy">
                        <img src="image/about/spanduk2.jpg" alt="Spanduk ZahraCell2" loading="lazy">
                    </div>
                </div>

                <div class="about-grid">

                    <div class="about-card">

                        <div class="about-icon">
                            🏪
                        </div>

                        <h3>
                            Toko Terpercaya
                        </h3>

                        <p>
                            Menyediakan berbagai kebutuhan pelanggan
                            dengan pelayanan yang ramah dan mudah.
                        </p>

                    </div>


                    <div class="about-card">

                        <div class="about-icon">
                            ⚡
                        </div>

                        <h3>
                            Layanan Lengkap
                        </h3>

                        <p>
                            Mulai dari BRILink, pulsa, token PLN,
                            ATK hingga perlengkapan listrik.
                        </p>

                    </div>


                    <div class="about-card">

                        <div class="about-icon">
                            🤝
                        </div>

                        <h3>
                            Mengutamakan Pelanggan
                        </h3>

                        <p>
                            Kepuasan dan kenyamanan pelanggan menjadi
                            salah satu prioritas kami.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- ================= LAYANAN ================= -->

        <section id="layanan" class="section services">

            <div class="container">

                <div class="section-heading">

                    <span class="section-label">
                        LAYANAN
                    </span>

                    <h2>
                        Layanan ZahraCell2
                    </h2>

                    <p>
                        Berbagai layanan yang dapat membantu
                        kebutuhan Anda.
                    </p>

                </div>


                <div class="services-grid">

                    <article class="service-card">

                        <div class="service-icon">
                            💳
                        </div>

                        <h3>
                            BRILink
                        </h3>

                        <p>
                            Layanan transfer, tarik tunai,
                            setor tunai dan transaksi lainnya.
                        </p>

                    </article>


                    <article class="service-card">

                        <div class="service-icon">
                            📱
                        </div>

                        <h3>
                            Pulsa & Paket Data
                        </h3>

                        <p>
                            Isi ulang pulsa dan paket data
                            berbagai operator.
                        </p>

                    </article>


                    <article class="service-card">

                        <div class="service-icon">
                            ⚡
                        </div>

                        <h3>
                            Token PLN
                        </h3>

                        <p>
                            Pembelian token listrik dengan
                            proses cepat dan praktis.
                        </p>

                    </article>


                    <article class="service-card">

                        <div class="service-icon">
                            📝
                        </div>

                        <h3>
                            ATK
                        </h3>

                        <p>
                            Berbagai alat tulis dan kebutuhan
                            perlengkapan kantor.
                        </p>

                    </article>


                    <article class="service-card">

                        <div class="service-icon">
                            💡
                        </div>

                        <h3>
                            Alat Listrik
                        </h3>

                        <p>
                            Lampu, kabel, saklar, stop kontak
                            dan berbagai kebutuhan listrik.
                        </p>

                    </article>


                    <article class="service-card">

                        <div class="service-icon">
                            💰
                        </div>

                        <h3>
                            Pembayaran
                        </h3>

                        <p>
                            Berbagai layanan pembayaran digital
                            sesuai kebutuhan pelanggan.
                        </p>

                    </article>

                </div>

            </div>

        </section>


        <!-- ================= PRODUK ================= -->

        <section id="produk" class="section products">

